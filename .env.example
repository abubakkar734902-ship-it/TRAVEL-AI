# TravelAI Environment Configuration
# Copy this file to .env and update with your values

# ========== Node Environment ==========
NODE_ENV=development

# ========== Backend Configuration ==========
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

# ========== Database Configuration ==========
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sih207
DB_USER=sih
DB_PASSWORD=sihpassword
DATABASE_URL=postgresql://sih:sihpassword@postgres:5432/sih207

# ========== Redis Configuration ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@redis:6379

# ========== MongoDB Configuration ==========
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=sih207
MONGO_USER=admin
MONGO_PASSWORD=mongopassword
MONGODB_URI=mongodb://admin:mongopassword@mongodb:27017/sih207

# ========== Elasticsearch Configuration ==========
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# ========== JWT Configuration ==========
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ========== Frontend Configuration ==========
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
FRONTEND_API_URL=http://localhost:5000/api
FRONTEND_SOCKET_URL=http://localhost:5000

# ========== Payment Gateway Configuration ==========
# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_MODE=sandbox

# ========== Email Configuration ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SENDER_EMAIL=noreply@travelai.com
SENDER_NAME=TravelAI

# ========== Monitoring & Logging ==========
# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_SITE=datadoghq.com

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# ========== Admin Configuration ==========
PGADMIN_EMAIL=admin@travelai.local
PGADMIN_PASSWORD=admin

GRAFANA_PASSWORD=admin

# ========== API Configuration ==========
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX_REQUESTS=100
API_TIMEOUT=30000

# ========== AWS Configuration (for deployment) ==========
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=travelai-bucket
AWS_CLOUDFRONT_DOMAIN=d123456.cloudfront.net

# ========== GCP Configuration (for deployment) ==========
GCP_PROJECT_ID=your_gcp_project_id
GCP_CREDENTIALS_PATH=./gcp-credentials.json

# ========== Azure Configuration (for deployment) ==========
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=travelai-rg
AZURE_STORAGE_ACCOUNT=travelaistg

# ========== Features Flags ==========
ENABLE_PAYMENT=true
ENABLE_NOTIFICATIONS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true

# ========== Logging Configuration ==========
LOG_LEVEL=info
LOG_FORMAT=json

# ========== Cache Configuration ==========
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ========== Notification Configuration ==========
NOTIFICATION_RETENTION_DAYS=7
NOTIFICATION_MAX_PER_USER=50

# ========== ML/AI Configuration ==========
ML_RECOMMENDATION_UPDATE_INTERVAL=86400
ML_RISK_ASSESSMENT_CACHE_TTL=3600
TREND_CALCULATION_WINDOW_DAYS=7
